<Project>
  <PropertyGroup Condition="'$(UseLocalDesignPatterns)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_DESIGNPATTERNS</DefineConstants>
  </PropertyGroup>

  <Import Condition="'$(DesignPatternsSampleKind)' == 'DependencyInjection' and Exists('$(DesignPatternsDiTargets)')" Project="$(DesignPatternsDiTargets)" />
  <Import Condition="('$(DesignPatternsSampleKind)' == 'PluginAssemblies' or '$(DesignPatternsPluginProvider)' == 'true' or '$(DesignPatternsPluginAnalyzerDemo)' == 'true') and Exists('$(DesignPatternsAutofacTargets)')" Project="$(DesignPatternsAutofacTargets)" />

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and ('$(DesignPatternsSampleKind)' != '' or '$(DesignPatternsPluginProvider)' == 'true' or '$(DesignPatternsPluginAnalyzerDemo)' == 'true')">
    <ProjectReference Include="$(DesignPatternsRuntimeProject)" />
    <ProjectReference Include="$(DesignPatternsGeneratorProject)">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and '$(DesignPatternsSampleKind)' == 'DependencyInjection'">
    <ProjectReference Include="$(DesignPatternsDiProject)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and ('$(DesignPatternsSampleKind)' == 'PluginAssemblies' or '$(DesignPatternsPluginProvider)' == 'true' or '$(DesignPatternsPluginAnalyzerDemo)' == 'true')">
    <ProjectReference Include="$(DesignPatternsAutofacProject)" />
    <PackageReference Include="Autofac" Version="8.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and '$(DesignPatternsPluginProvider)' == 'true'">
    <ProjectReference Include="$(DesignPatternsAnalyzersProject)">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and '$(DesignPatternsSampleKind)' == 'PluginAssemblies'">
    <ProjectReference Include="$(DesignPatternsAppSettingsProject)" />
    <ProjectReference Include="$(DesignPatternsAnalyzersProject)">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and '$(DesignPatternsPluginAnalyzerDemo)' == 'true'">
    <ProjectReference Include="$(DesignPatternsAnalyzersProject)">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and ('$(DesignPatternsPluginProvider)' == 'true' or '$(DesignPatternsSampleKind)' == 'PluginAssemblies' or '$(DesignPatternsPluginAnalyzerDemo)' == 'true')">
    <Analyzer Include="$(DesignPatternsRepoRoot)/DesignPatterns.Analyzers/bin/$(Configuration)/netstandard2.0/DesignPatterns.Analyzers.dll"
              Condition="Exists('$(DesignPatternsRepoRoot)/DesignPatterns.Analyzers/bin/$(Configuration)/netstandard2.0/DesignPatterns.Analyzers.dll')" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' != 'true' and ('$(DesignPatternsSampleKind)' != '' or '$(DesignPatternsPluginProvider)' == 'true' or '$(DesignPatternsPluginAnalyzerDemo)' == 'true')">
    <PackageReference Include="Skymly.DesignPatterns" Version="$(DesignPatternsPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' != 'true' and '$(DesignPatternsSampleKind)' == 'DependencyInjection'">
    <PackageReference Include="Skymly.DesignPatterns.Extensions.DependencyInjection" Version="$(DesignPatternsPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' != 'true' and ('$(DesignPatternsSampleKind)' == 'PluginAssemblies' or '$(DesignPatternsPluginProvider)' == 'true' or '$(DesignPatternsPluginAnalyzerDemo)' == 'true')">
    <PackageReference Include="Skymly.DesignPatterns.Extensions.Autofac" Version="$(DesignPatternsPackageVersion)" />
    <PackageReference Include="Autofac" Version="8.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' != 'true' and '$(DesignPatternsSampleKind)' == 'PluginAssemblies'">
    <PackageReference Include="DesignPatterns.Extensions.AppSettings" Version="$(DesignPatternsPackageVersion)" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
</Project>
