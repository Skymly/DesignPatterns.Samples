<Project>
  <PropertyGroup Condition="'$(UseLocalDesignPatterns)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_DESIGNPATTERNS</DefineConstants>
  </PropertyGroup>

  <Import Condition="'$(DesignPatternsSampleKind)' == 'DependencyInjection' and Exists('$(DesignPatternsDiTargets)')" Project="$(DesignPatternsDiTargets)" />

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and '$(DesignPatternsSampleKind)' != ''">
    <ProjectReference Include="$(DesignPatternsRuntimeProject)" />
    <ProjectReference Include="$(DesignPatternsGeneratorProject)">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' == 'true' and '$(DesignPatternsSampleKind)' == 'DependencyInjection'">
    <ProjectReference Include="$(DesignPatternsDiProject)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' != 'true' and '$(DesignPatternsSampleKind)' != ''">
    <PackageReference Include="DesignPatterns" Version="$(DesignPatternsPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalDesignPatterns)' != 'true' and '$(DesignPatternsSampleKind)' == 'DependencyInjection'">
    <PackageReference Include="DesignPatterns.Extensions.DependencyInjection" Version="$(DesignPatternsPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>
</Project>
